<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="pos_navbar_logo_inherit" inherit_id="point_of_sale.Navbar" name="POS Logo Inherit">
    <xpath expr="//img[@class='pos-logo pos-logo mw-100']" position="replace">
      <!-- Replace with your own logo -->
      <img class="pos-logo pos-logo mw-100"
           height="42"
           src="/pos_logo/static/src/img/logo.png"
           alt="My Logo"/>
    </xpath>
  </template>
</odoo>
